  },
  "dependencies": {
    "@image-bill-chat/shared": "workspace:*",
    "hono": "^4.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.14.0"
  }
}
